# ─────────────────────────────────────────────────────────────────────────────
# ThinkDome Production Environment Configuration Template
# Copy this file to .env and ensure all generated secrets are populated.
# Or run: ./scripts/setup_docker_prod.sh to auto-generate this file.
# ─────────────────────────────────────────────────────────────────────────────

# Deployment Environment ("production" enforces strict isolation & secret invariants)
DEPLOYMENT_ENV=production

# ── Database (PostgreSQL with Non-Default Credentials) ────────────────────────
POSTGRES_DB=thinkdome
POSTGRES_USER=thinkdome
POSTGRES_PASSWORD=replace_with_strong_random_postgres_password_here
DATABASE_URL=postgresql://thinkdome:replace_with_strong_random_postgres_password_here@postgres:5432/thinkdome

# ── Message Queue (RabbitMQ with Non-Default Credentials) ─────────────────────
RABBITMQ_DEFAULT_USER=thinkdome
RABBITMQ_DEFAULT_PASS=replace_with_strong_random_rabbitmq_password_here
RABBITMQ_URL=amqp://thinkdome:replace_with_strong_random_rabbitmq_password_here@rabbitmq:5672/

# ── Cache & Session Store (Redis) ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Cryptographic Secrets (Minimum 32 Characters Each) ───────────────────────
JWT_SECRET_KEY=replace_with_random_hex_jwt_secret_at_least_32_characters_here
WORKSPACE_MASTER_KEY=replace_with_random_hex_vault_key_at_least_32_characters_here

# ── Docker Executor Service (DIND-002 Boundary) ──────────────────────────────
# Dedicated microservice that controls the container daemon.
EXECUTOR_CONTROL_URL=http://thinkdome-docker-executor:8200
EXECUTOR_CONTROL_AUTH_TOKEN=replace_with_random_token_at_least_32_characters_here
EXECUTOR_CONTROL_PORT=8200

# ── Container Runtime Configuration ──────────────────────────────────────────
EXECUTOR_BACKEND=docker
# In production, EXECUTOR_IMAGE MUST be an immutable @sha256 reference
EXECUTOR_IMAGE=thinkdome-executor:latest

# DinD TLS Connection (Managed automatically by Compose volume)
DOCKER_HOST=tcp://dind:2376
DOCKER_TLS_VERIFY=true
DOCKER_CERT_PATH=/certs/client

# ── Storage & Sandbox Resource Limits ────────────────────────────────────────
FILE_STORAGE_DIR=/data/storage
POOL_ENABLED=true
POOL_MIN_WARM=3
POOL_MAX_SIZE=50
IDLE_TIMEOUT_SEC=180
MAX_EXEC_TIMEOUT_MS=30000
CPU_TIME_LIMIT_SEC=10
MEMORY_LIMIT_MB=256

# ── Observability (OpenTelemetry) ────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=thinkdome

